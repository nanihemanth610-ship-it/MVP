# BillBridge Environment Configuration
# Copy this template to .env.local for local development.
# CRITICAL SECURITY RULE: NEVER commit real keys or secrets to version control.

# ==============================================================================
# CLIENT-SIDE VARIABLES (Exposed to browser bundle via Vite)
# ==============================================================================
# Supabase Public API (Anon Key only — protected by Row Level Security)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# n8n Webhook Endpoint (External event dispatching)
VITE_N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# ==============================================================================
# SERVER-SIDE / EDGE FUNCTION VARIABLES (PRIVILEGED - NEVER USE VITE_ PREFIX!)
# Configure these in Supabase Dashboard (Settings -> Secrets) or server environment
# ==============================================================================
# Google Gemini Multimodal Vision API Key (Kept strictly behind server boundary)
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Service Role Key (Bypasses RLS - admin / migration tasks only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
